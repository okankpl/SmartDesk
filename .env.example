# PostgreSQL-Zugangsdaten für den lokalen Docker-Container
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=smartdesk
POSTGRES_DB=smartdesk

# Verbindungs-URL für das Backend. "postgres" ist der Servicename aus docker-compose.yml,
# nicht "localhost" - innerhalb des Docker-Netzwerks heißen Container wie ihr Service.
DATABASE_URL=postgresql+psycopg://smartdesk:smartdesk@postgres:5432/smartdesk

# Eigener, geheimer Wert zum Signieren von JWTs - fuer den lokalen Rechner z.B. per
# `python3 -c "import secrets; print(secrets.token_hex(32))"` erzeugen. NIE committen.
# Das Backend startet mit diesem Platzhalter (oder einem Wert unter 32 Zeichen)
# absichtlich NICHT - siehe secret_key_must_be_strong in backend/app/core/config.py.
SECRET_KEY=change-me-to-a-random-value

# Nur docker-compose.demo.yml aktiviert bekannte Demo-Konten in einer eigenen DB.
DEMO_MODE=false

# Gemeinsamer Login-Schutz für alle Backend-Prozesse. Redis bleibt intern.
LOGIN_RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=300

# Ab hier: nur fuer ein echtes Deployment relevant (siehe docs/deployment.md).
# Lokal einfach weglassen - config.py hat sinnvolle Defaults fuer beides.
#
# Die Herkunfts-Adresse, von der aus Anfragen erlaubt sind (CORS). Lokal per
# Default "http://localhost:4200" - auf dem Server die echte Domain eintragen,
# z.B. https://smartdesk.example.com
# FRONTEND_ORIGIN=https://smartdesk.example.com
#
# Muss auf dem Server auf "true" stehen, sobald HTTPS laeuft (siehe Caddyfile) -
# sonst wird der Auth-Cookie nur ueber unverschluesseltes HTTP uebertragen.
# COOKIE_SECURE=true
